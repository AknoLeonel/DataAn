---
import { formatValue } from '../lib/format';
import { categoryName } from '../lib/data';
import { sparkline } from '../lib/charts/sparkline';
import { url } from '../lib/site';
import type { CatalogEntry } from '../lib/types';
import Icon from './Icon.astro';

interface Props {
  entry: CatalogEntry;
  headingLevel?: 2 | 3;
}
const { entry, headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
const k = entry.headline;
const search = [entry.title, entry.summary, categoryName(entry.category), ...entry.tags, ...entry.sources]
  .join(' ')
  .normalize('NFD')
  .replace(/[̀-ͯ]/g, '')
  .toLowerCase();
const spark = k?.spark?.length ? sparkline(k.spark, `Tendência de ${k.label}`, 96, 30) : '';
---
<article class="card ds-card" data-card data-category={entry.category} data-search={search}>
  <a class:list={['tag', `cat-${entry.category}`]} href={url(`/categorias/${entry.category}/`)}>{categoryName(entry.category)}</a>
  <H><a href={url(`/dados/${entry.slug}/`)}>{entry.title}</a></H>
  <p>{entry.summary}</p>
  {k && (
    <div class="headline">
      <div class="kpi">
        <span class="kpi-label">{k.label}</span>
        <span class="kpi-value">{formatValue(k.value, k.format, { unit: false })}{k.format.unit && <span class="unit">{k.format.unit}</span>}</span>
      </div>
      {spark && <Fragment set:html={spark} />}
    </div>
  )}
  <div class="foot">
    {entry.stale ? (
      <span class="status-pill st-warning"><Icon name="alert" />Desatualizado</span>
    ) : (
      <span>{entry.frequency}{entry.data_until && ` · dados até ${entry.data_until}`}</span>
    )}
  </div>
</article>
