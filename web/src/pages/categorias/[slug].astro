---
import Base from '../../layouts/Base.astro';
import DatasetCard from '../../components/DatasetCard.astro';
import { getCatalog } from '../../lib/data';
import { absolute, url } from '../../lib/site';

export function getStaticPaths() {
  return (getCatalog()?.categories ?? []).map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params as { slug: string };
const catalog = getCatalog()!;
const category = catalog.categories.find((c) => c.slug === slug)!;
const entries = catalog.datasets.filter((d) => d.category === slug);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${category.name} — dados públicos`,
    description: category.description,
    url: absolute(`/categorias/${slug}/`),
    hasPart: entries.map((e) => ({ '@type': 'Dataset', name: e.title, url: absolute(`/dados/${e.slug}/`) })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: 'Categorias', item: absolute('/categorias/') },
      { '@type': 'ListItem', position: 3, name: category.name, item: absolute(`/categorias/${slug}/`) },
    ],
  },
];
---
<Base title={`${category.name}: dados e gráficos`} description={category.description} jsonld={jsonld}>
  <div class="container page-flow">
    <nav class="crumbs" aria-label="Trilha de navegação">
      <ol>
        <li><a href={url('/')}>Início</a></li>
        <li><a href={url('/categorias/')}>Categorias</a></li>
        <li aria-current="page">{category.name}</li>
      </ol>
    </nav>
    <header>
      <h1>{category.name}</h1>
      <p class="lead muted">{category.description}</p>
    </header>
    <div class="chips" aria-label="Outras categorias">
      {catalog.categories.map((c) => (
        <a class:list={['chip', { 'is-active': c.slug === slug }]} href={url(`/categorias/${c.slug}/`)} aria-current={c.slug === slug ? 'page' : undefined}>{c.name}</a>
      ))}
    </div>
    <div class="grid grid-3">
      {entries.map((e) => <DatasetCard entry={e} headingLevel={2} />)}
    </div>
  </div>
</Base>
