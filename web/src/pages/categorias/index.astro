---
import Base from '../../layouts/Base.astro';
import { getCatalog } from '../../lib/data';
import { url } from '../../lib/site';

const catalog = getCatalog();
const categories = catalog?.categories ?? [];
---
<Base title="Categorias" description="Todas as áreas de dados públicos do DataAn: economia, saúde, meio ambiente, clima e demografia.">
  <div class="container page-flow">
    <nav class="crumbs" aria-label="Trilha de navegação">
      <ol><li><a href={url('/')}>Início</a></li><li aria-current="page">Categorias</li></ol>
    </nav>
    <header>
      <h1>Categorias</h1>
      <p class="lead muted">Cada área reúne conjuntos de dados com a mesma lógica: fonte oficial, validação e atualização automática.</p>
    </header>
    {categories.length === 0 && <p class="card empty">Nenhuma categoria publicada ainda.</p>}
    <div class="grid grid-2">
      {categories.map((c) => {
        const items = catalog!.datasets.filter((d) => d.category === c.slug);
        return (
          <section class="card ds-card" aria-labelledby={`cat-${c.slug}`}>
            <span class:list={['tag', `cat-${c.slug}`]}>{c.count} {c.count === 1 ? 'conjunto' : 'conjuntos'}</span>
            <h2 id={`cat-${c.slug}`}><a href={url(`/categorias/${c.slug}/`)}>{c.name}</a></h2>
            <p>{c.description}</p>
            <ul class="small">
              {items.map((d) => <li>{d.title}</li>)}
            </ul>
          </section>
        );
      })}
    </div>
  </div>
</Base>
